# All optional. EXPO_PUBLIC_* values are inlined at BUILD time. After changing one, restart
# with `npx expo start --clear` — without --clear, Metro serves a cached bundle with the OLD value. Read them only as static `process.env.EXPO_PUBLIC_X`; dynamic access is not
# inlined and silently yields undefined (see lib/config.ts).

# Directory on the CDN holding catalog.<locale>.json and weather.<city>.json.
# Local development:
#   cd .. && npm run db:reset && npm run catalog:export && npm run dev:weather
#   npx serve ../out -l 3000        (any static server)
EXPO_PUBLIC_CDN_URL=http://localhost:3000

# Stage 2+. Without it, "Report a problem" falls back to email and nothing syncs.
EXPO_PUBLIC_API_URL=

# A MapLibre style JSON — e.g. a Protomaps style pointing at montreal.pmtiles on R2.
# Without it the map draws markers on a plain canvas. See ../docs/alentour/09-architecture.md.
EXPO_PUBLIC_MAP_STYLE_URL=

EXPO_PUBLIC_SUPPORT_EMAIL=allo@alentour.app
EXPO_PUBLIC_WEB_URL=https://alentour.app
