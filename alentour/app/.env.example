# Where the app fetches the catalog. EXPO_PUBLIC_* is inlined by the bundler at build time
# and works on every platform, including static web exports — unlike app.json `extra`, which
# resolves at runtime and is not always populated on web.
#
# Local development against a locally-served catalog:
#   cd .. && npm run catalog:export
#   npx serve out            # or any static server
#   EXPO_PUBLIC_CATALOG_URL=http://localhost:3000/catalog.fr-CA.json npm start
EXPO_PUBLIC_CATALOG_URL=
