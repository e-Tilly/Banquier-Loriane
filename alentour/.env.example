# Postgres — local only in Stage 1. This database never gets deployed;
# it is the authoring source for the static catalog file.
DATABASE_URL=postgres://localhost:5432/alentour

# Anthropic. Leave unset to use an `ant auth login` profile instead.
ANTHROPIC_API_KEY=

# Outreach identity — CASL requires these in every message footer.
# A real, reachable mailing address is legally mandatory. A PO box is acceptable.
OUTREACH_SENDER_NAME="Alentour"
OUTREACH_SENDER_PERSON="<your name>"
OUTREACH_REPLY_TO="you@example.com"
OUTREACH_MAILING_ADDRESS="123 Rue Example, Montréal, QC H2X 1Y4, Canada"
OUTREACH_UNSUBSCRIBE_BASE=https://alentour.example/u

# Safety rails. Keep DRY_RUN=1 until a lawyer has reviewed the templates.
OUTREACH_DRY_RUN=1
OUTREACH_DAILY_CAP=20
