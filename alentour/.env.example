# ─── Database (local Postgres; Stage 2+ also a hosted one) ───────────────────
DATABASE_URL=postgres://localhost:5432/alentour

# ─── API (Stage 2+) ──────────────────────────────────────────────────────────
# 32+ random characters:  openssl rand -hex 32
API_SECRET=
PORT=8787
# Comma-separated origins allowed to call the API from a browser ("*" in dev only).
CORS_ORIGINS=
# Set to 1 behind a load balancer / Fly / Render so rate limits key on the real client IP.
TRUST_PROXY=
# Email for sign-in codes. Without it (dev), codes are printed to the API log.
RESEND_API_KEY=
MAIL_FROM="Alentour <allo@alentour.app>"
# Sign in with Apple / Google — the audiences your ID tokens are minted for.
APPLE_AUDIENCE=app.alentour.mobile
GOOGLE_AUDIENCE=

# ─── Anthropic (enrichment, outreach, concierge) ─────────────────────────────
ANTHROPIC_API_KEY=

# ─── Outreach identity — CASL requires these in every message footer ─────────
OUTREACH_SENDER_NAME="Alentour"
OUTREACH_SENDER_PERSON="<your name>"
OUTREACH_REPLY_TO="you@example.com"
OUTREACH_MAILING_ADDRESS="123 Rue Example, Montréal, QC H2X 1Y4, Canada"
OUTREACH_UNSUBSCRIBE_BASE=https://alentour.example/u
# Keep DRY_RUN=1 until a lawyer has reviewed the templates.
OUTREACH_DRY_RUN=1
OUTREACH_DAILY_CAP=20

# ─── Photos (Stage 4) ─────────────────────────────────────────────────────────
# Production: Cloudflare R2 via its S3 API. Without these (dev), photos go to MEDIA_DIR and the
# API serves them at /media.
R2_ENDPOINT=
R2_BUCKET=alentour-media
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
MEDIA_PUBLIC_URL=
MEDIA_DIR=var/media

# ─── Onboarding / enrichment (Stage 4) ───────────────────────────────────────
# Daily ceilings on AI drafts: the API key is the one thing here that costs per request.
ENRICH_PER_USER_DAILY=5
ENRICH_DAILY_LIMIT=100
# Public base URL of this API, used in the monthly "still accurate?" emails.
PUBLIC_URL=http://localhost:8787

# ─── Outings (Stage 5) ───────────────────────────────────────────────────────
# Severity-3+ reports and critical chat messages are emailed here immediately.
OPERATOR_EMAIL=
# SMS for phone verification (required to join an outing). Without these (dev), codes are
# printed to the API log.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=

# ─── Business Pro billing (Stage 6) ──────────────────────────────────────────
# Stripe: a product with a monthly ($29) and a yearly ($290) price, Stripe Tax on for GST/QST,
# and a webhook to <PUBLIC_URL>/v1/stripe/webhook listening to checkout.session.completed and
# customer.subscription.created/updated/deleted. Without these, the billing page says Pro isn't
# available yet.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
