{
  "name": "alentour",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Alentour — a filterable dictionary of local activities. Stage 1 toolchain.",
  "engines": { "node": ">=22" },
  "scripts": {
    "typecheck": "tsc --noEmit",
