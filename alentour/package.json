{
  "name": "alentour",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Alentour \u2014 a filterable dictionary of local activities. Stage 1 toolchain.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "taxonomy:check": "node --experimental-strip-types src/taxonomy/check.ts",
    "catalog:export": "node --experimental-strip-types src/catalog/export.ts",
    "outreach:run": "node --experimental-strip-types src/outreach/run.ts",
    "db:migrate": "node --experimental-strip-types scripts/db.ts migrate",
    "db:seed": "node --experimental-strip-types scripts/db.ts seed",
    "db:reset": "node --experimental-strip-types scripts/db.ts reset",
    "weather:publish": "node --experimental-strip-types src/weather/publish.ts",
    "dev:weather": "node --experimental-strip-types scripts/dev-weather.ts",
    "api:dev": "node --experimental-strip-types --watch src/api/server.ts",
    "api:start": "node --experimental-strip-types src/api/server.ts",
    "admin": "node --experimental-strip-types scripts/admin.ts",
    "enrich": "node --experimental-strip-types scripts/enrich.ts",
    "freshness": "node --experimental-strip-types scripts/freshness.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@hono/node-server": "^1.19.17",
    "hono": "^4.13.9",
    "jose": "^6.2.12",
    "pg": "^8.13.1",
    "pg-connection-string": "^2.14.0",
    "yaml": "^2.6.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/geojson": "^7946.0.16",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "typescript": "^5.7.2"
  }
}
